ENVIRONMENT=production

# URL de conexão com o banco de dados PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/nome_do_banco

# Chave secreta para geração de tokens JWT
SECRET_KEY=sua_chave_secreta_aqui

# Algoritmo de criptografia para JWT
ALGORITHM=HS256

# Tempo de expiração do token de acesso (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=https://dip-ai.vercel.app,https://*.vercel.app
API_BASE_URL=https://186.213.212.140
SSL_ENABLED=true